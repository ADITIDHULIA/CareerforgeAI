# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://careerforge:careerforge_secret@localhost:5433/careerforge_db?schema=public"

# Authentication
JWT_SECRET="your-secure-jwt-secret-here-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Google Gemini AI Integration
# Obtain a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# CORS
CORS_ORIGIN="http://localhost:5173"
